{
	"$schema": "https://turbo.build/schema.json",
	"concurrency": "20",
	"globalEnv": ["CI"],
	"globalPassThroughEnv": [
		"PL_UP_E2E",
		"PL_UP_PORT",
		"PL_UP_PREFIX",
		"PRISMALENS_SMOKE_PORT",
		"PRISMALENS_TARBALL"
	],
	"tasks": {
		"clean": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**", "*.xml"]
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"db:generate": {
			"cache": false,
			"dependsOn": ["@prismalens/config#build"]
		},
		"@prismalens/database#build": {
			"dependsOn": ["^build", "db:generate"],
			"outputs": ["dist/**"]
		},
		"@prismalens/database#typecheck": {
			"dependsOn": ["^build", "db:generate"]
		},
		"@prismalens/database#test": {
			"dependsOn": ["^build", "db:generate"],
			"outputs": ["coverage/**", "*.xml"]
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:deploy": {
			"cache": false
		},
		"db:init": {
			"cache": false,
			"passThroughEnv": ["PRISMALENS_WORKSPACE_DIR", "PRISMALENS_SEED_DEMO"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:reset": {
			"cache": false
		},
		"//#format-and-lint": {},
		"//#format-and-lint:fix": {
			"cache": false
		}
	}
}
