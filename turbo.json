{
	"$schema": "https://turbo.build/schema.json",
	"agentGuidance": false,
	"concurrency": "20",
	"globalEnv": ["CI"],
	"globalPassThroughEnv": [
		"BASE_REF",
		"GITHUB_BASE_REF",
		"GITHUB_HEAD_REF",
		"PL_UP_E2E",
		"PL_UP_PORT",
		"PL_UP_PREFIX",
		"PRISMALENS_SMOKE_PORT",
		"PRISMALENS_TARBALL"
	],
	"tasks": {
		"clean": {
			"cache": false
		},
		"registry:gen": {
			"cache": false
		},
		"ui:check": {
			"cache": false,
			"dependsOn": ["^build", "registry:gen"]
		},
		"build": {
			"dependsOn": ["^build", "registry:gen"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["registry:gen"],
			"passThroughEnv": [
				"PRISMALENS_*",
				"NODE_ENV",
				"DO_NOT_TRACK",
				"ANTHROPIC_*",
				"OPENAI_*",
				"GEMINI_*",
				"GOOGLE_*",
				"OPENROUTER_*"
			]
		},
		"@prismalens/frontend#build:gallery": {
			"dependsOn": ["^build", "registry:gen"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^build", "registry:gen"]
		},
		"test": {
			"env": ["VITEST_TIMEOUT_BUDGET"],
			"dependsOn": ["^build", "registry:gen"],
			"outputs": ["coverage/**", "*.xml"]
		},
		"test:cov": {
			"env": ["VITEST_TIMEOUT_BUDGET"],
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^build", "registry:gen"]
		},
		"db:generate": {
			"cache": false,
			"dependsOn": ["@prismalens/config#build"]
		},
		"@prismalens/database#build": {
			"dependsOn": ["^build", "db:generate"],
			"outputs": ["dist/**"]
		},
		"@prismalens/database#typecheck": {
			"dependsOn": ["^build", "db:generate"]
		},
		"@prismalens/database#test": {
			"env": ["VITEST_TIMEOUT_BUDGET"],
			"dependsOn": ["^build", "db:generate"],
			"outputs": ["coverage/**", "*.xml"]
		},
		"db:migrate": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["PRISMALENS_WORKSPACE_DIR", "PRISMALENS_DB_URL"]
		},
		"db:init": {
			"cache": false,
			"passThroughEnv": ["PRISMALENS_WORKSPACE_DIR", "PRISMALENS_SEED_DEMO"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["PRISMALENS_WORKSPACE_DIR", "PRISMALENS_DB_URL"]
		},
		"db:reset": {
			"cache": false,
			"passThroughEnv": ["PRISMALENS_WORKSPACE_DIR", "PRISMALENS_DB_URL"]
		},
		"//#format-and-lint": {},
		"//#format-and-lint:fix": {
			"cache": false
		}
	}
}
