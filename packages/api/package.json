{
	"name": "@prismalens/api",
	"version": "0.0.1",
	"description": "PrismaLens API - NestJS REST API server",
	"author": "PrismaLens Team",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"//main": "`pl up` imports this to boot the API in-process. nest build infers its output root from the widest common source dir, so this path moves if a file outside src/ enters the program — scripts/pack-cli.mjs asserts the file exists in the copied output rather than letting that become a runtime failure.",
	"main": "dist/src/main.js",
	"scripts": {
		"dev": "NODE_ENV=development nest start --watch --preserveWatchOutput",
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/main.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist && rm -rf node_modules",
		"openapi:generate": "tsx scripts/generate-openapi.ts"
	},
	"dependencies": {
		"@nestjs/common": "catalog:",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "catalog:",
		"@nestjs/event-emitter": "^3.1.0",
		"@nestjs/platform-express": "^11.1.28",
		"@nestjs/serve-static": "^5.0.5",
		"@nestjs/swagger": "^11.4.6",
		"@nestjs/throttler": "^6.5.0",
		"@orpc/nest": "^1.14.15",
		"@orpc/openapi": "^1.14.15",
		"@orpc/server": "^1.14.15",
		"@orpc/zod": "^1.14.15",
		"@prismalens/auth": "workspace:*",
		"@prismalens/config": "workspace:*",
		"@prismalens/contracts": "workspace:*",
		"@prismalens/database": "workspace:*",
		"@prismalens/integrations": "workspace:*",
		"@prismalens/logger": "workspace:*",
		"@prismalens/worker": "workspace:*",
		"better-auth": "catalog:",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "catalog:",
		"svix": "^1.99.1"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.5.0",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.28",
		"@swc/core": "^1.15.47",
		"@types/express": "^5.0.6",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "^4.1.10",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"unplugin-swc": "^1.5.10",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
