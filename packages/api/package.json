{
	"name": "@prismalens/api",
	"version": "0.0.1",
	"description": "PrismaLens API - NestJS REST API server",
	"author": "PrismaLens Team",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"//main": "`pl up` imports this to boot the API in-process. nest build infers its output root from the widest common source dir, so this path moves if a file outside src/ enters the program — scripts/pack-cli.mjs asserts the file exists in the copied output rather than letting that become a runtime failure.",
	"main": "dist/src/main.js",
	"scripts": {
		"dev": "dotenv -e dev-defaults.env --no-expand -- cross-env NODE_ENV=development nest start --watch --preserveWatchOutput",
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/src/main.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"typecheck": "tsc --noEmit && tsc -p ../../scripts/journeys/tsconfig.json",
		"clean": "rm -rf dist && rm -rf node_modules",
		"openapi:generate": "tsx scripts/generate-openapi.ts",
		"seed:away": "tsx scripts/seed-away.ts",
		"seed:huge-output": "tsx scripts/seed-huge-output.ts",
		"seed:long-thread": "tsx scripts/seed-long-thread.ts",
		"seed:thread-list": "tsx scripts/seed-thread-list.ts",
		"fixture:pr-checks": "tsx scripts/fixture-pr-checks.ts"
	},
	"dependencies": {
		"@lezer/highlight": "^1.2.5",
		"@lezer/lr": "^1.4.12",
		"@lydell/node-pty": "1.2.0-beta.18",
		"@modelcontextprotocol/client": "~2.4.0",
		"@modelcontextprotocol/server": "~2.4.0",
		"@nestjs/common": "catalog:",
		"@nestjs/config": "^12.1.1",
		"@nestjs/core": "catalog:",
		"@nestjs/event-emitter": "^12.0.3",
		"@nestjs/platform-express": "^12.6.0",
		"@nestjs/serve-static": "^12.1.1",
		"@nestjs/throttler": "^6.8.0",
		"@orpc/nest": "^1.16.5",
		"@orpc/openapi": "^1.16.5",
		"@orpc/server": "^1.16.5",
		"@orpc/zod": "^1.16.5",
		"@prismalens/agent-host": "workspace:*",
		"@prismalens/auth": "workspace:*",
		"@prismalens/config": "workspace:*",
		"@prismalens/contracts": "workspace:*",
		"@prismalens/database": "workspace:*",
		"@prismalens/engine": "workspace:*",
		"@prismalens/integrations": "workspace:*",
		"@prismalens/logger": "workspace:*",
		"@prometheus-io/lezer-promql": "^0.316.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"compression": "1.8.2",
		"croner": "^11.0.1",
		"cronstrue": "^3.43.0",
		"cross-spawn": "^7.0.6",
		"express": "^5.3.0",
		"file-type": "^22.3.0",
		"fuzzysort": "4.0.2",
		"helmet": "^8.3.0",
		"ignore": "7.0.16",
		"playwright-core": "1.65.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "catalog:",
		"svix": "^2.11.0",
		"unpdf": "2.2.1",
		"web-push": "^4.0.0",
		"ws": "8.23.0",
		"yaml": "^2.9.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@nestjs/cli": "^12.0.15",
		"@nestjs/schematics": "^12.0.16",
		"@nestjs/testing": "^12.6.0",
		"@swc/core": "^1.16.22",
		"@types/compression": "1.8.1",
		"@types/cross-spawn": "^6.0.6",
		"@types/express": "^5.0.6",
		"@types/node": "catalog:",
		"@types/web-push": "^3.6.4",
		"@types/ws": "8.18.2",
		"@vitest/coverage-v8": "^5.1.1",
		"cross-env": "^10.1.0",
		"dotenv-cli": "^11.1.0",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"unplugin-swc": "^2.0.0",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
