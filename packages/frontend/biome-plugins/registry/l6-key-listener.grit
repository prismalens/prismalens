// L6: keys go through the shortcut runner (hooks/use-global-shortcuts.ts, listenKeys), so the ? sheet,
// the palette and Settings list every one.
language js

or {
	`$target.addEventListener($event, $_)`,
	`$target.addEventListener($event, $_, $_)`
} as $call where {
	$event <: or {
		`"keydown"`,
		`"keyup"`,
		`"keypress"`,
		`'keydown'`,
		`'keyup'`,
		`'keypress'`
	},
	register_diagnostic(span=$call, message="[L6] A key listener outside the shortcut runner. Fix: give the action `keys` so the runner runs it, or subscribe with listenKeys from hooks/use-global-shortcuts.", severity="warn")
}
