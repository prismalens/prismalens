// L1: a setting is defined only in its kind's *.settings.ts files, so the collector and the
// generator see every one. biome.json scopes this plugin to everything else.
language js

or {
	`define.setting($def)` as $call where {
		register_diagnostic(span=$call, message="[L1] A setting is defined only in a *.settings.ts file. Fix: move this call into the object's *.settings.ts (`pnpm new setting <id>` writes one).", severity="warn")
	}
}
