		"react-resizable-panels": "^4.16.1",
		"recharts": "^3.10.1",
		"shell-quote": "^1.12.0",
		"simple-icons": "^16.36.0",
		"streamdown": "^2.7.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"use-stick-to-bottom": "^1.1.6",
		"virtua": "0.54.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@axe-core/playwright": "~4.14.0",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/hast": "3.0.4",
		"@types/mdast": "4.0.4",
		"@types/node": "catalog:",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/shell-quote": "^1.7.5",
		"@vitejs/plugin-react": "^6.2.1",
		"eslint": "catalog:",
		"happy-dom": "^21.0.3",
		"playwright-bdd": "^9.2.1",
		"typescript": "catalog:",
