		"@pierre/diffs": "1.5.2",
		"@pierre/trees": "1.0.0-beta.6",
		"@prismalens/auth": "workspace:*",
		"@prismalens/config": "workspace:*",
		"@prismalens/contracts": "workspace:*",
		"@prismalens/registry": "workspace:*",
		"@radix-ui/react-alert-dialog": "^1.2.1",
