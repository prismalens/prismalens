{
	"name": "@prismalens/frontend",
	"version": "0.0.1",
	"license": "Apache-2.0",
	"description": "PrismaLens Frontend - TanStack Start dashboard for incident analysis",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"entry:budget": "node scripts/entry-budget.mjs",
		"start": "node .output/server/index.mjs",
		"lint": "biome check src e2e --config-path ../../biome.json && bash scripts/lint-look.sh",
		"lint:look": "bash scripts/lint-look.sh",
		"ui:shots": "bash scripts/ui-shots.sh design-shots/matrix",
		"ui:budget": "node scripts/ui-budget.mjs design-shots/matrix",
		"registry:check": "node ../@prismalens/registry/src/cli.ts gen --check && node ../@prismalens/registry/src/cli.ts ratchet && vitest run src/registry",
		"ui:check:static": "pnpm -w exec biome lint packages/frontend/src --reporter=default --reporter=json --reporter-file=packages/frontend/node_modules/.registry-lint.json && bash scripts/lint-look.sh && bash scripts/ui-gates.sh && node ../@prismalens/registry/src/cli.ts gen --check && node ../@prismalens/registry/src/cli.ts ratchet --report node_modules/.registry-lint.json --report-cwd ../.. && vitest run src/registry",
		"ui:check": "pnpm ui:check:static && bash scripts/ui-shots.sh design-shots/matrix && node scripts/check-ui-budget.mjs design-shots/matrix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "bddgen && playwright test",
		"clean": "rm -rf dist && rm -rf node_modules"
	},
	"dependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
