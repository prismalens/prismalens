{
	"name": "@prismalens/desktop",
	"version": "0.5.2",
	"private": true,
	"author": {
		"name": "PrismaLens",
		"url": "https://prismalens.io"
	},
	"homepage": "https://prismalens.io",
	"description": "The Electron launcher: spawns the same backend `pl up` runs, opens a window on it, and adds presence.",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "concurrently -k -n tsc,electron -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"PRISMALENS_DESKTOP_DEV_URL=${PRISMALENS_DESKTOP_DEV_URL:-http://localhost:${PRISMALENS_FRONTEND_PORT:-3000}} electronmon .\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"start": "electron .",
		"stage:backend": "node scripts/pack-desktop.mjs",
		"dist": "pnpm run build && pnpm run stage:backend && electron-builder --dir",
		"smoke": "node scripts/smoke-desktop.mjs"
	},
	"dependencies": {
		"@prismalens/auth": "workspace:*",
		"@prismalens/config": "workspace:*",
		"electron-context-menu": "5.1.0",
		"electron-window-state": "5.0.3"
	},
	"devDependencies": {
		"@electron/asar": "4.3.1",
		"@types/node": "catalog:",
		"concurrently": "^10.0.6",
		"electron": "45.1.0",
		"electron-builder": "^26.18.0",
		"electronmon": "^2.0.4",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"build": {
		"appId": "io.prismalens.desktop",
		"productName": "PrismaLens",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**",
			"assets/**",
			"package.json"
		],
		"extraResources": [
			{
				"from": "resources/prismalens.asar",
				"to": "prismalens.asar"
			},
			{
				"from": "resources/prismalens.asar.unpacked",
				"to": "prismalens.asar.unpacked"
			}
		],
		"asar": true,
		"mac": {
			"target": "dir",
			"extraResources": [
				{
					"from": "node_modules/electron/dist/LICENSE",
					"to": "LICENSE.electron.txt"
				},
				{
					"from": "node_modules/electron/dist/LICENSES.chromium.html",
					"to": "LICENSES.chromium.html"
				}
			]
		},
		"linux": {
			"target": "dir",
			"executableName": "prismalens"
		},
		"win": {
			"target": "dir",
			"executableName": "PrismaLens"
		}
	}
}
