{
	"name": "prismalens",
	"version": "0.4.0",
	"description": "AI root-cause investigation from your terminal — point it at a repo, pipe it an alert, get an evidence-linked report",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"prismalens": "./dist/bin/prismalens.js",
		"pl": "./dist/bin/prismalens.js"
	},
	"files": [
		"dist",
		"NOTICE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prismalens/prismalens.git",
		"directory": "packages/cli"
	},
	"homepage": "https://prismalens.io",
	"bugs": "https://github.com/prismalens/prismalens/issues",
	"keywords": [
		"sre",
		"incident-response",
		"root-cause-analysis",
		"investigation",
		"observability",
		"devops",
		"ai",
		"cli"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "../../scripts/pack-cli-artifact.sh",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"dev": "tsx bin/prismalens.ts",
		"test": "vitest run --coverage"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.23",
		"@ai-sdk/google": "^4.0.26",
		"@ai-sdk/groq": "^4.0.15",
		"@ai-sdk/openai": "^4.0.22",
		"@ai-sdk/openai-compatible": "^3.0.16",
		"@anthropic-ai/claude-agent-sdk": "^0.3.220",
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/common": "^11.1.28",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.28",
		"@nestjs/event-emitter": "^3.1.0",
		"@nestjs/platform-express": "^11.1.28",
		"@nestjs/serve-static": "^5.0.5",
		"@nestjs/swagger": "^11.4.6",
		"@orpc/contract": "^1.14.12",
		"@orpc/nest": "^1.14.12",
		"@orpc/openapi": "^1.14.12",
		"@orpc/server": "^1.14.12",
		"@orpc/zod": "^1.14.12",
		"@prisma/adapter-better-sqlite3": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"ai": "^7.0.40",
		"better-auth": "~1.6.25",
		"better-sqlite3": "^12.11.1",
		"bullmq": "^5.81.2",
		"citty": "^0.2.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"consola": "^3.4.2",
		"env-paths": "^4.0.0",
		"express": "^5.2.1",
		"ioredis": "^5.11.1",
		"json-rpc-2.0": "^1.7.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"svix": "^1.99.1",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@prismalens/config": "workspace:*",
		"@prismalens/contracts": "workspace:*",
		"@prismalens/engine": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "^4.1.10",
		"tsup": "^8.5.1",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
