{
	"name": "prismalens",
	"version": "0.5.3",
	"description": "Self-hosted incident investigation: an alert arrives, the coding agent you already use investigates a snapshot of the service's code, and the run, evidence and cause stay on the incident.",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"prismalens": "./dist/bin/prismalens.js",
		"pl": "./dist/bin/prismalens.js"
	},
	"files": [
		"dist",
		"NOTICE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prismalens/prismalens.git",
		"directory": "packages/cli"
	},
	"homepage": "https://prismalens.io",
	"bugs": "https://github.com/prismalens/prismalens/issues",
	"keywords": [
		"sre",
		"incident-response",
		"root-cause-analysis",
		"investigation",
		"observability",
		"devops",
		"ai",
		"cli"
	],
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"dev": "tsx bin/prismalens.ts",
		"test": "vitest run --coverage",
		"test:cov": "vitest run --coverage"
	},
	"dependencies": {
		"citty": "^0.2.2",
		"consola": "^3.4.2",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@prismalens/api": "workspace:*",
		"@prismalens/auth": "workspace:*",
		"@prismalens/config": "workspace:*",
		"@prismalens/contracts": "workspace:*",
		"@prismalens/database": "workspace:*",
		"@prismalens/engine": "workspace:*",
		"@types/node": "catalog:",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^5.0.5",
		"cross-spawn": "^7.0.6",
		"tsup": "^9.0.0",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
