{
	"name": "@prismalens/worker",
	"version": "0.0.1",
	"license": "Apache-2.0",
	"description": "PrismaLens per-run investigation child process, forked by the API dispatch loop",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./protocol": {
			"types": "./dist/protocol.d.ts",
			"import": "./dist/protocol.js",
			"default": "./dist/protocol.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint src/**/*.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@orpc/client": "catalog:",
		"@orpc/contract": "catalog:",
		"@prismalens/config": "workspace:*",
		"@prismalens/contracts": "workspace:*",
		"@prismalens/engine": "workspace:*",
		"@prismalens/logger": "workspace:*",
		"dotenv": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
