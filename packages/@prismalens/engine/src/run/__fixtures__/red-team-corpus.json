{
	"about": "The access gate's oracle (r4 R4.1 rev). Authored from the class descriptions, apart from permission.ts. Add instances freely; never remove or weaken one. Each instance gives the outcome at every level; `why` is the refusal reason, one string for every refusing level or one per level. `kind` defaults to execute; `path` is a tool path parameter.",
	"brief": {
		"prometheusUrl": "http://prom.internal:9090",
		"alertmanagerUrl": "http://am.internal:9093",
		"apiUrl": "http://api.internal:8080",
		"logsUrl": "https://logs.internal"
	},
	"levels": ["read-only", "read-only-tools", "workspace-write", "full-access"],
