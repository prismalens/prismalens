// =============================================================================
// AUTHENTICATION (Better Auth) - SQLite
// =============================================================================
// Better Auth manages authentication with these models.
//
// To regenerate this file when updating Better Auth:
//   npx @better-auth/cli generate --output prisma/sqlite/schema/auth.prisma
//
// NOTE: After regeneration, manually add app-specific User relations back:
//   - assignedIncidents, timelineEntries, postmortems
// =============================================================================

/// User account - managed by Better Auth with PrismaLens extensions
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // PrismaLens-specific fields
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  // Relations (Better Auth)
  sessions Session[]
  accounts Account[]

  // Relations (PrismaLens) - ADD THESE BACK AFTER REGENERATION
  assignedIncidents Incident[]      @relation("AssignedTo")
  timelineEntries   TimelineEntry[]

  @@map("user")
}

/// Session - managed by Better Auth
model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Two-factor authentication
  twoFactorVerified Boolean?

  // Active organization (for organization plugin)
  activeOrganizationId String?

  // Impersonation (for admin plugin)
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Account - stores auth provider credentials (Better Auth)
model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String // "credential", "google", "github", etc.
  issuer                String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String? // For email/password auth (hashed)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

/// Verification - email verification and password reset tokens (Better Auth)
model Verification {
  id         String   @id @default(uuid())
  identifier String // Email or phone number
  value      String // Token or code
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// =============================================================================
// DEVICE PAIRING (ADR 0004 §8)
// =============================================================================
// A device that is not the host gets in by pairing: the operator mints a
// one-time link on the host, the device that opens it holds a session until
// revoked. Only hashes are stored; the raw token is shown once at creation.

/// One-time pairing link, minted on the host
model PairingLink {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  label     String?
  scopes    String    @default("[\"investigate:read\",\"investigate:operate\"]") // JSON array the redeemed device gets
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  device DeviceSession?

  @@map("pairing_link")
}

/// A paired device's session: valid until revoked
model DeviceSession {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  name          String
  scopes        String // JSON array of scope names (ADR 0004 §8)
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime?
  revokedAt     DateTime?
  pairingLinkId String    @unique

  pairingLink PairingLink @relation(fields: [pairingLinkId], references: [id])

  @@map("device_session")
}
