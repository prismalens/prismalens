{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"rewriteRelativeImportExtensions": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"exclude": [
		"node_modules",
		"dist",
		"src/**/*.test.ts",
		"src/kinds/**",
		"src/conformance/**"
	]
}
