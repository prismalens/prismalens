{
	"name": "@prismalens/agent-adapters",
	"version": "0.0.2",
	"license": "Apache-2.0",
	"private": true,
	"description": "The ACP adapters PrismaLens ships for agents that do not speak ACP themselves, pinned to the versions the registry tested",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc && node scripts/bundle.mjs",
		"dev": "node scripts/bundle.mjs && tsc --watch",
		"test": "vitest run",
		"clean": "rm -rf dist && rm -rf node_modules",
		"typecheck": "tsc --noEmit",
		"pack:npm": "pnpm run build && node scripts/pack.mjs"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.280"
	},
	"devDependencies": {
		"@agentclientprotocol/claude-agent-acp": "0.81.1",
		"@agentclientprotocol/codex-acp": "2.2.2",
		"@agentclientprotocol/sdk": "2.0.2",
		"@types/node": "catalog:",
		"esbuild": "^0.28.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist"
	]
}
