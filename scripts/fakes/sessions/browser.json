{
	"description": "An agent that uses PrismaLens's browser: the first open asks, then it reads the page and clicks its submit button, which waits for the host's card; each allowed card reopens it (#1061).",
	"agent": {
		"name": "opencode",
		"version": "1.18.30-fake"
	},
	"turns": [
		[
			{
				"call": {
					"tool": "pl_browser_open",
					"arguments": { "url": "{{url}}" }
				}
			},
			{ "say": "Open: {{result}}\n" }
		]
	],
	"followUpWhen": [
		{
			"match": "The user allowed: Let the agent use the browser?",
			"steps": [
				{
					"call": {
						"tool": "pl_browser_open",
						"arguments": { "url": "{{url}}" }
					}
				},
				{ "say": "Opened: {{result}}\n" },
				{
					"call": {
						"tool": "pl_browser_snapshot",
						"arguments": { "tab": "t1" }
					}
				},
				{ "say": "Snapshot: {{result}}\n" },
				{
					"call": {
						"tool": "pl_browser_act",
						"arguments": { "tab": "t1", "ref": "e9", "action": "click" }
					}
				},
				{ "say": "Submit: {{result}}\n" }
			]
		},
		{
			"match": "The page's request went out",
			"steps": [
				{
					"call": {
						"tool": "pl_browser_snapshot",
						"arguments": { "tab": "t1" }
					}
				},
				{ "say": "After: {{result}}\n" }
			]
		}
	],
	"followUp": [{ "say": "Heard: {{prompt}}" }]
}
