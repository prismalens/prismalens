{
	"row": "gateway-wakeup-schedule",
	"kind": "happy",
	"title": "Schedules its own wake through PrismaLens's pl_wakeup_schedule tool, then reports",
	"run": {},
	"expect": "gateway",
	"gateway": {
		"calls": [
			{
				"name": "pl_wakeup_schedule",
				"ok": true,
				"outputHas": "scheduled"
			}
		]
	},
	"fixtures": [
		{
			"match": {
				"inConversation": "[row:gateway-wakeup-schedule]",
				"toolName": "$gw:pl_wakeup_schedule",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_wakeup_schedule",
						"arguments": {
							"delaySeconds": 600,
							"reason": "Check the rollout"
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-wakeup-schedule]",
				"hasToolResult": true
			},
			"response": {
				"content": "$report"
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-wakeup-schedule]"
			},
			"response": {
				"content": "$report"
			}
		}
	]
}
