{
	"row": "gateway-thread-roster",
	"kind": "happy",
	"title": "Reads the thread tree through PrismaLens's tree tool, listed or found by search",
	"run": {},
	"expect": "gateway",
	"gateway": {
		"calls": [
			{
				"name": "thread_roster",
				"ok": true,
				"outputHas": "ScenarioTreeChild"
			}
		]
	},
	"fixtures": [
		{
			"match": {
				"inConversation": "[row:gateway-thread-roster]",
				"toolName": "$gw:thread_roster",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:thread_roster",
						"arguments": {}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-thread-roster]",
				"toolName": "$gw:tools_search",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:tools_search",
						"arguments": {
							"query": "thread tree roster"
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-thread-roster]",
				"afterTool": "$gw:tools_search",
				"resultContains": "thread_roster"
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:tools_call",
						"arguments": {
							"name": "thread_roster",
							"arguments": {}
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-thread-roster]",
				"resultContains": "ScenarioTreeChild"
			},
			"response": {
				"content": "$report"
			}
		}
	]
}
