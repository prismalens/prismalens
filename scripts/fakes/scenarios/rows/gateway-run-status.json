{
	"row": "gateway-run-status",
	"kind": "happy",
	"title": "Reads the run's own state through PrismaLens's run tool, listed or found by search",
	"run": {},
	"expect": "gateway",
	"gateway": {
		"calls": [
			{
				"name": "run_status",
				"ok": true,
				"outputHas": "ScenarioRepo"
			}
		]
	},
	"fixtures": [
		{
			"match": {
				"inConversation": "[row:gateway-run-status]",
				"toolName": "$gw:run_status",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:run_status",
						"arguments": {}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-run-status]",
				"toolName": "$gw:tools_search",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:tools_search",
						"arguments": {
							"query": "run status"
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-run-status]",
				"afterTool": "$gw:tools_search",
				"resultContains": "run_status"
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:tools_call",
						"arguments": {
							"name": "run_status",
							"arguments": {}
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-run-status]",
				"resultContains": "ScenarioRepo"
			},
			"response": {
				"content": "$report"
			}
		}
	]
}
