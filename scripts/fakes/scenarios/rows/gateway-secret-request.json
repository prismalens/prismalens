{
	"row": "gateway-secret-request",
	"kind": "happy",
	"title": "Asks the user for a credential through PrismaLens's pl_secret_request tool, which names only the variable, then reports",
	"run": {},
	"expect": "gateway",
	"gateway": {
		"calls": [
			{
				"name": "pl_secret_request",
				"ok": true,
				"outputHas": "SCENARIO_TOKEN"
			}
		]
	},
	"fixtures": [
		{
			"match": {
				"inConversation": "[row:gateway-secret-request]",
				"toolName": "$gw:pl_secret_request",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_secret_request",
						"arguments": {
							"name": "SCENARIO_TOKEN",
							"reason": "Read the scenario service's admin API"
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-secret-request]",
				"hasToolResult": true
			},
			"response": {
				"content": "$report"
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-secret-request]"
			},
			"response": {
				"content": "$report"
			}
		}
	]
}
