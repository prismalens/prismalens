{
	"row": "gateway-fixes-list",
	"kind": "happy",
	"title": "Lists fixes proposed on past investigations through PrismaLens's fixes tool, listed or found by search",
	"run": {},
	"expect": "gateway",
	"gateway": {
		"calls": [
			{
				"name": "pl_fixes_list",
				"ok": true,
				"outputHas": "ScenarioFixTitle"
			}
		]
	},
	"fixtures": [
		{
			"match": {
				"inConversation": "[row:gateway-fixes-list]",
				"toolName": "$gw:pl_fixes_list",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_fixes_list",
						"arguments": {}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-fixes-list]",
				"toolName": "$gw:pl_tools_search",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_tools_search",
						"arguments": {
							"query": "past fixes"
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-fixes-list]",
				"afterTool": "$gw:pl_tools_search",
				"resultContains": "pl_fixes_list"
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_tools_call",
						"arguments": {
							"name": "pl_fixes_list",
							"arguments": {}
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-fixes-list]",
				"resultContains": "ScenarioFixTitle"
			},
			"response": {
				"content": "$report"
			}
		}
	]
}
