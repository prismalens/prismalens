{
	"row": "gateway-knowledge",
	"kind": "happy",
	"title": "Finds a past cause through PrismaLens's knowledge tool, listed or found by search",
	"run": {},
	"expect": "gateway",
	"gateway": {
		"calls": [
			{
				"name": "pl_investigations_search",
				"ok": true,
				"outputHas": "ScenarioPastCause",
				"input": {
					"query": "checkout timeouts"
				}
			}
		]
	},
	"fixtures": [
		{
			"match": {
				"inConversation": "[row:gateway-knowledge]",
				"toolName": "$gw:pl_investigations_search",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_investigations_search",
						"arguments": {
							"query": "checkout timeouts"
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-knowledge]",
				"toolName": "$gw:pl_tools_search",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_tools_search",
						"arguments": {
							"query": "past investigations"
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-knowledge]",
				"afterTool": "$gw:pl_tools_search",
				"resultContains": ["pl_investigations_search", "inputSchema", "query"]
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_tools_call",
						"arguments": {
							"name": "pl_investigations_search",
							"arguments": {
								"query": "checkout timeouts"
							}
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-knowledge]",
				"resultContains": "ScenarioPastCause"
			},
			"response": {
				"content": "$report"
			}
		}
	]
}
