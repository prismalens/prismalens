{
	"row": "gateway-pr-watch",
	"kind": "happy",
	"title": "Links a pull request with pl_pr_link and watches its checks with pl_pr_watch, then reports",
	"run": {},
	"expect": "gateway",
	"gateway": {
		"calls": [
			{
				"name": "pl_pr_link",
				"ok": true,
				"outputHas": "stub-pr-1"
			},
			{
				"name": "pl_pr_watch",
				"ok": true,
				"outputHas": "scenario/app#1"
			}
		]
	},
	"fixtures": [
		{
			"match": {
				"inConversation": "[row:gateway-pr-watch]",
				"toolName": "$gw:pl_pr_link",
				"hasToolResult": false
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_pr_link",
						"arguments": {
							"url": "https://github.com/scenario/app/pull/1"
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-pr-watch]",
				"afterTool": "$gw:pl_pr_link"
			},
			"response": {
				"toolCalls": [
					{
						"name": "$gw:pl_pr_watch",
						"arguments": {
							"prId": "stub-pr-1",
							"until": "checks_done"
						}
					}
				]
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-pr-watch]",
				"hasToolResult": true
			},
			"response": {
				"content": "$report"
			}
		},
		{
			"match": {
				"inConversation": "[row:gateway-pr-watch]"
			},
			"response": {
				"content": "$report"
			}
		}
	]
}
