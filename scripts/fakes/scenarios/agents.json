{
	"description": "Each agent's shell tool and the argument that carries the command, read from aimock's journal (GET /__aimock/journal, #914). `extra` holds arguments the agent's schema requires besides the command.",
	"agents": {
		"opencode": {
			"shell": "bash",
			"command": "command",
			"extra": { "description": "Scenario step" }
		},
		"claude-code": {
			"shell": "Bash",
			"command": "command",
			"extra": { "description": "Scenario step" }
		},
		"codex": { "shell": "exec_command", "command": "cmd", "extra": {} },
		"gemini": {
			"shell": "run_shell_command",
			"command": "command",
			"extra": { "description": "Scenario step" }
		},
		"deepagents": { "shell": "execute", "command": "command", "extra": {} }
	}
}
