{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "ES2023",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strictNullChecks": true,
		"types": ["node"]
	},
	"include": [
		"*.mjs",
		"*.d.mts",
		"targets/*.mjs",
		"targets/*.d.mts",
		"../packed-intake.mjs"
	]
}
