	{
		"file": "nightly.yml",
		"job": "nightly-draft",
		"call": null,
		"steps": [
			{
				"uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
				"with": {
					"ref": "${{ github.sha }}",
					"fetch-depth": 0,
					"persist-credentials": false
				},
				"env": null
			},
			{
				"run": "set -euo pipefail\nprev=$(gh release list -R \"$REPO\" --limit 100 --json tagName,isPrerelease,isDraft \\\n  --jq '[.[] | select(.isPrerelease and (.isDraft | not) and (.tagName | contains(\"-nightly.\")))][0].tagName // empty')\necho \"prev=$prev\" >> \"$GITHUB_OUTPUT\"\nif [ -n \"$prev\" ]; then\n  prev_sha=$(gh api \"repos/$REPO/commits/$prev\" --jq .sha)\n  if [ \"$prev_sha\" = \"$SHA\" ]; then\n    echo \"::notice::$prev already is $SHA; nothing to publish\"\n    echo \"new=false\" >> \"$GITHUB_OUTPUT\"\n    exit 0\n  fi\n  git merge-base --is-ancestor \"$prev_sha\" \"$SHA\" || { echo \"::error::$SHA is not ahead of $prev ($prev_sha)\"; exit 1; }\nfi\n# Nightlies live on GitHub only (#717): the newest published one orders the next version.\necho \"above=${prev#v}\" >> \"$GITHUB_OUTPUT\"\necho \"new=true\" >> \"$GITHUB_OUTPUT\"",
				"cwd": ".",
				"env": null
			},
			{
				"uses": "pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115",
				"with": null,
				"env": null
			},
			{
				"uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
				"with": {
					"node-version-file": ".nvmrc",
					"cache": "pnpm"
				},
				"env": null
			},
			{
				"run": "pnpm install --frozen-lockfile",
				"cwd": ".",
				"env": null
			},
			{
				"run": "set -euo pipefail\ndate=$(gh api \"repos/$REPO/actions/runs/$RUN_ID\" --jq .created_at | cut -c1-10 | tr -d -)\nversion=$(node scripts/nightly-version.mjs --stable \"$(jq -r '.\".\"' .release-please-manifest.json)\" \\\n  --date \"$date\" --run \"$RUN_NUMBER\" ${ABOVE:+--above \"$ABOVE\"} --write packages/cli/package.json)\necho \"version=$version\" >> \"$GITHUB_OUTPUT\"\necho \"Nightly $version from $SHA\" >> \"$GITHUB_STEP_SUMMARY\"",
				"cwd": ".",
				"env": {
					"RUN_ID": "${{ github.run_id }}",
					"RUN_NUMBER": "${{ github.run_number }}",
					"ABOVE": "${{ steps.since.outputs.above }}"
				}
			},
			{
				"run": "set -eu\nif [ \"$(gh release view \"v$VERSION\" -R \"$REPO\" --json isDraft --jq .isDraft 2>/dev/null)\" = false ]; then\n  echo \"::notice::v$VERSION is already published\"\n  exit 0\nfi\ngh api \"repos/$REPO/git/refs/tags/v$VERSION\" >/dev/null 2>&1 ||\n  gh api \"repos/$REPO/git/refs\" -f ref=\"refs/tags/v$VERSION\" -f sha=\"$SHA\" >/dev/null\nif ! gh release view \"v$VERSION\" -R \"$REPO\" >/dev/null 2>&1; then\n  {\n    echo \"A build of main at $SHA, published because that night's proofs passed. It may migrate a workspace past the last stable release.\"\n    echo\n    echo \"Install the stable release (\\`npm install -g prismalens\\`), then switch with \\`pl upgrade --channel nightly\\`.\"\n    [ -z \"$PREV\" ] || { echo; echo \"Changes since $PREV: https://github.com/$REPO/compare/$PREV...$SHA\"; }\n  } > \"$RUNNER_TEMP/notes.md\"\n  gh release create \"v$VERSION\" -R \"$REPO\" --draft --prerelease --latest=false --verify-tag \\\n    --title \"Nightly $VERSION\" --notes-file \"$RUNNER_TEMP/notes.md\"\nfi\necho \"build=true\" >> \"$GITHUB_OUTPUT\"",
				"cwd": ".",
				"env": {
					"VERSION": "${{ steps.version.outputs.version }}",
					"PREV": "${{ steps.since.outputs.prev }}"
				}
			}
		]
