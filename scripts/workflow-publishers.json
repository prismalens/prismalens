					"path": "launcher"
				},
				"env": null
			},
			{
				"run": "# npm's own `latest`, read now: a newer version published meanwhile keeps it.\nnpm_latest=$(npm view prismalens@latest version 2>/dev/null || true)\nnewest=$(printf '%s\\n%s\\n' \"$npm_latest\" \"$VERSION\" | sort -V | tail -1)\ntag=previous\nif [ \"$LATEST\" = true ] && [ \"$newest\" = \"$VERSION\" ]; then tag=latest; fi\nnode scripts/pack-launcher.mjs --publish --tarball \"$TARBALL\" --tag \"$tag\"",
