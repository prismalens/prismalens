	{
		"file": "nightly.yml",
		"job": "report",
		"call": null,
		"steps": [
			{
				"uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
				"with": {
					"persist-credentials": false,
					"sparse-checkout": ".github/actions\nscripts\n",
					"sparse-checkout-cone-mode": false
				},
				"env": null
			},
			{
				"run": "for stage in $STAGES; do\n  case \"$stage\" in failure | cancelled) PUBLISH=$stage; break ;; esac\ndone\necho \"result=$PUBLISH\" >> \"$GITHUB_OUTPUT\"",
				"cwd": ".",
				"env": {
					"STAGES": "${{ needs.nightly-draft.result }} ${{ needs.nightly-standalone.result }} ${{ needs.nightly-sums.result }}",
					"PUBLISH": "${{ needs.publish.result }}"
				}
			},
			{
				"run": "if [ \"$EVENT\" != workflow_dispatch ] && [ \"$ENABLED\" != true ]; then\n  echo \"skipped=true\" >> \"$GITHUB_OUTPUT\"\n  echo \"The nightly was skipped: the repository variable NIGHTLY_ENABLED is \\\"${ENABLED:-unset}\\\", not \\\"true\\\". No issue was touched.\" | tee -a \"$GITHUB_STEP_SUMMARY\"\nfi",
				"cwd": ".",
				"env": {
					"ENABLED": "${{ vars.NIGHTLY_ENABLED }}",
					"EVENT": "${{ github.event_name }}"
				}
			},
			{
				"run": "set -eu\nlive_red=false\nfor job in $LIVE; do case \"$job\" in failure | cancelled) live_red=true ;; esac; done\nok=false\nif [ \"$PROOFS\" = success ] && [ \"$PUBLISH\" != failure ] && [ \"$PUBLISH\" != cancelled ] && [ \"$live_red\" = false ]; then ok=true; fi\nfailed=$(gh api \"repos/$REPO/actions/runs/$RUN_ID/jobs\" --paginate --jq '.jobs[] | select(.conclusion != null and .conclusion != \"success\" and .conclusion != \"skipped\" and .name != \"Nightly tracking issue\") | \"- \\(.name): \\(.conclusion) \\(.html_url)\"')\nbt='`'\n{\n  echo \"ok=$ok\"\n  echo \"body<<NIGHTLY_BODY_EOF\"\n  echo \"The nightly proofs ended $bt$PROOFS$bt, its publish $bt$PUBLISH$bt and the live checks $bt$LIVE$bt: $RUN_URL\"\n  echo\n  echo \"Red jobs:\"\n  echo \"${failed:-- none listed; the run was cancelled or a job never started}\"\n  echo\n  echo \"These run outside pull requests and never block one. This issue closes itself on the next green night.\"\n  echo \"NIGHTLY_BODY_EOF\"\n} >> \"$GITHUB_OUTPUT\"",
				"cwd": ".",
				"env": {
					"GH_TOKEN": "${{ github.token }}",
					"REPO": "${{ github.repository }}",
					"RUN_URL": "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}",
					"RUN_ID": "${{ github.run_id }}",
					"PROOFS": "${{ needs.proofs.result }}",
					"PUBLISH": "${{ steps.publication.outputs.result }}",
					"LIVE": "${{ needs.live-pack.result }} ${{ needs.packed-intake-live.result }} ${{ needs.harness-admission-live.result }}"
				}
			},
			{
				"uses": "./.github/actions/report-failure",
				"with": {
					"title": "Nightly CI failing",
					"body": "${{ steps.night.outputs.body }}",
					"ok": "${{ steps.night.outputs.ok }}",
					"dry-run": "${{ github.event_name == 'workflow_dispatch' && inputs.report != true }}"
				},
				"env": null
			}
		]
	},
