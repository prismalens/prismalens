{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/*.test.ts",
			"!**/*.spec.ts",
			"packages/frontend/e2e/**/*.spec.ts",
			"packages/frontend/e2e/**/*.test.ts",
			"!**/*.md",
			"!**/*.yaml",
			"!**/*.yml",
			"!**/routeTree.gen.ts",
			"!**/registry.gen.ts",
			"!**/registry.manifest.json",
			"!**/project.inlang",
			"!packages/@prismalens/engine/eval/captures",
			"!packages/@prismalens/engine/src/run/__fixtures__/red-team-corpus.json",
			"!packages/frontend/src/app.css",
			"!packages/frontend/src/styles/tailwind-preset.css",
			"!**/app.css",
			"!**/tailwind-preset.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noLabelWithoutControl": "warn",
				"noStaticElementInteractions": "warn",
				"useKeyWithClickEvents": "warn"
			},
			"correctness": {
				"noComponentHookFactories": "warn",
				"useExhaustiveDependencies": "warn",
				"usePlaywrightValidDescribeCallback": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn"
			}
		}
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		},
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/frontend/e2e/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noDocumentCookie": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.controller.ts",
				"**/*.service.ts",
				"**/*.guard.ts",
				"**/*.resolver.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"useImportType": "off"
					}
				}
			}
		},
		{
			"includes": [
				"packages/@prismalens/engine/src/**",
				"packages/@prismalens/engine/eval/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@prismalens/database": "the engine must not depend on @prismalens/database \u00e2\u20ac\u201d it stays db-clean per ADR-0011.",
									"@prismalens/integrations": "the engine must not depend on @prismalens/integrations \u00e2\u20ac\u201d that couples it to app-side external services.",
									"@prismalens/auth": "the engine must not depend on @prismalens/auth \u00e2\u20ac\u201d that couples it to the app's auth layer.",
									"@prismalens/api": "the engine must not depend on @prismalens/api \u00e2\u20ac\u201d that couples it to the app.",
									"@prismalens/frontend": "the engine must not depend on @prismalens/frontend \u00e2\u20ac\u201d that couples it to the app."
								},
								"patterns": [
									{
										"group": ["../**/api/**", "../**/frontend/**"],
										"message": "the engine must not reach into packages/api or packages/frontend via relative import \u00e2\u20ac\u201d that breaks the extraction seam."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/cli/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@prismalens/database": "the CLI must not depend on @prismalens/database \u00e2\u20ac\u201d that couples it to the app's persistence layer.",
									"@prismalens/integrations": "the CLI must not depend on @prismalens/integrations \u00e2\u20ac\u201d that couples it to app-side external services.",
									"@prismalens/api": "the CLI must not depend on @prismalens/api \u00e2\u20ac\u201d that couples it to the app.",
									"@prismalens/frontend": "the CLI must not depend on @prismalens/frontend \u00e2\u20ac\u201d that couples it to the app."
								},
								"patterns": [
									{
										"group": ["../**/api/**", "../**/frontend/**"],
										"message": "the CLI must not reach into packages/api or packages/frontend via relative import \u00e2\u20ac\u201d that breaks the extraction seam."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/frontend/src/**",
				"!packages/frontend/src/components/ui/**"
			],
			"linter": {
				"rules": {
					"nursery": {
						"noTailwindRawColors": "error",
						"useTailwindStaticClassStrings": "error",
						"noTailwindRestyledComponents": {
							"level": "warn",
							"options": {
								"allow": [
									{
										"components": [
											"Link",
											"Hint",
											"AlertTriangle",
											"Boxes",
											"Check",
											"ChevronDown",
											"ChevronRight",
											"FileText",
											"FolderGit2",
											"GitBranch",
											"GitCommitHorizontal",
											"Globe",
											"Link2",
											"Lock",
											"Menu",
											"MessageSquare",
											"Play",
											"Plug",
											"RefreshCw",
											"Search",
											"Server",
											"ServerOff",
											"Square",
											"SquareTerminal",
											"Star",
											"TriangleAlert"
										],
										"categories": [
											"color",
											"typography",
											"spacing",
											"shape",
											"effects",
											"motion"
										],
										"advice": "Links, hints and icons pass their classes through; only the design system's own components keep their look."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"tailwind": {
		"stylesheet": "packages/frontend/src/app.css"
	},
	"plugins": [
		{
			"path": "./packages/frontend/biome-plugins/one-spinner.grit",
			"includes": [
				"packages/frontend/src/**/*.tsx",
				"!packages/frontend/src/components/ui/**",
				"!packages/frontend/src/components/shared/Ring.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/token-colours.grit",
			"includes": [
				"packages/frontend/src/**/*.tsx",
				"!packages/frontend/src/components/ui/**",
				"!packages/frontend/src/components/icons/prismalens-mark.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/one-page-header.grit",
			"includes": [
				"packages/frontend/src/**/*.tsx",
				"!packages/frontend/src/components/ui/**",
				"!packages/frontend/src/components/shell/PageHeader.tsx",
				"!packages/frontend/src/components/run/IncidentHeader.tsx",
				"!packages/frontend/src/components/Sidebar.tsx",
				"!packages/frontend/src/components/run/RunDetailsPanel.tsx",
				"!packages/frontend/src/components/thread/ThreadPanel.tsx",
				"!packages/frontend/src/components/thread/panel/ThreadSidePanel.tsx",
				"!packages/frontend/src/components/TitleBarStrip.tsx",
				"!packages/frontend/src/components/alerts/AlertDetail.tsx",
				"!packages/frontend/src/components/projects/ProjectList.tsx",
				"!packages/frontend/src/components/projects/ProjectPage.tsx",
				"!packages/frontend/src/components/thread/ThreadPage.tsx",
				"!packages/frontend/src/routes/_authenticated/incidents/$id/route.tsx",
				"!packages/frontend/src/routes/_authenticated/schedules/$id.tsx",
				"!packages/frontend/src/routes/_authenticated/schedules/$id_.runs.$runId.tsx",
				"!packages/frontend/src/routes/_authenticated/services/$id/index.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/native-elements.grit",
			"includes": [
				"packages/frontend/src/**/*.tsx",
				"!packages/frontend/src/components/ui/**"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/hairline-edges.grit",
			"includes": [
				"packages/frontend/src/**/*.tsx",
				"!packages/frontend/src/components/ui/**",
				"!packages/frontend/src/components/shared/Row.tsx",
				"!packages/frontend/src/components/shared/SettingRow.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l1-action.grit",
			"includes": [
				"packages/frontend/src/**",
				"!packages/frontend/src/**/*.actions.ts",
				"!packages/frontend/src/**/*.test.ts",
				"!packages/frontend/src/**/*.test.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l1-block.grit",
			"includes": [
				"packages/frontend/src/**",
				"!packages/frontend/src/**/*.blocks.ts",
				"!packages/frontend/src/**/*.test.ts",
				"!packages/frontend/src/**/*.test.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l1-setting.grit",
			"includes": [
				"packages/frontend/src/**",
				"!packages/frontend/src/**/*.settings.ts",
				"!packages/frontend/src/**/*.test.ts",
				"!packages/frontend/src/**/*.test.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l1-surface.grit",
			"includes": [
				"packages/frontend/src/**",
				"!packages/frontend/src/**/*.surface.ts",
				"!packages/frontend/src/**/*.test.ts",
				"!packages/frontend/src/**/*.test.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l2-literal-id.grit",
			"includes": [
				"packages/frontend/src/**/*.actions.ts",
				"packages/frontend/src/**/*.surface.ts",
				"packages/frontend/src/**/*.blocks.ts",
				"packages/frontend/src/**/*.settings.ts"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l3-inline-menu.grit",
			"includes": [
				"packages/frontend/src/**/*.tsx",
				"!packages/frontend/src/components/kit/Menu.tsx",
				"!packages/frontend/src/**/*.test.ts",
				"!packages/frontend/src/**/*.test.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l4-typed-when.grit",
			"includes": ["packages/frontend/src/**/*.actions.ts"]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l5-surface-attr.grit",
			"includes": [
				"packages/frontend/src/**/*.tsx",
				"!packages/frontend/src/components/kit/Surface.tsx",
				"!packages/frontend/src/**/*.test.ts",
				"!packages/frontend/src/**/*.test.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l6-key-listener.grit",
			"includes": [
				"packages/frontend/src/**",
				"!packages/frontend/src/hooks/use-global-shortcuts.ts",
				"!packages/frontend/src/**/*.test.ts",
				"!packages/frontend/src/**/*.test.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l7-registry-imports.grit",
			"includes": [
				"packages/frontend/src/**",
				"!packages/frontend/src/**/*.actions.ts",
				"!packages/frontend/src/**/*.surface.ts",
				"!packages/frontend/src/**/*.blocks.ts",
				"!packages/frontend/src/**/*.settings.ts",
				"!packages/frontend/src/registry/**",
				"!packages/frontend/src/**/*.test.ts",
				"!packages/frontend/src/**/*.test.tsx"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l8-registry-deps.grit",
			"includes": [
				"packages/frontend/src/**/*.actions.ts",
				"packages/frontend/src/**/*.surface.ts",
				"packages/frontend/src/**/*.blocks.ts",
				"packages/frontend/src/**/*.settings.ts"
			]
		},
		{
			"path": "./packages/frontend/biome-plugins/registry/l9-hand-list.grit",
			"includes": [
				"packages/frontend/src/**",
				"!packages/frontend/src/registry/**",
				"!packages/frontend/src/**/*.actions.ts",
				"!packages/frontend/src/**/*.surface.ts",
				"!packages/frontend/src/**/*.blocks.ts",
				"!packages/frontend/src/**/*.settings.ts",
				"!packages/frontend/src/**/*.test.ts",
				"!packages/frontend/src/**/*.test.tsx",
				"!packages/frontend/src/design/gallery.*.tsx"
			]
		}
	]
}
